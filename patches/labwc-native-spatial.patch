+static bool
+output_config_unchanged(struct wlr_output_configuration_head_v1 *head)
+{
+	struct wlr_output *o = head->state.output;
+	struct output *output = output_from_wlr_output(o);
+	if (output->pending.committed || head->state.enabled != o->enabled) {
+		return false;
+	}
+	struct wlr_output_layout_output *layout =
+		wlr_output_layout_get(server.output_layout, o);
+	if (!o->enabled) {
+		return !layout;
+	}
+	bool same_mode = head->state.mode ? o->current_mode == head->state.mode :
+		(!o->current_mode && o->width == head->state.custom_mode.width &&
+		 o->height == head->state.custom_mode.height &&
+		 o->refresh == head->state.custom_mode.refresh);
+	return same_mode && layout && layout->x == head->state.x &&
+		layout->y == head->state.y && o->scale == head->state.scale &&
+		o->transform == head->state.transform &&
+		(o->adaptive_sync_status == WLR_OUTPUT_ADAPTIVE_SYNC_ENABLED) ==
+		head->state.adaptive_sync_enabled;
+}
