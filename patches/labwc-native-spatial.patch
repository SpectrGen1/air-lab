diff --git a/src/xdg-popup.c b/src/xdg-popup.c
index 7ca9ab0..6adb71b 100644
--- a/src/xdg-popup.c
+++ b/src/xdg-popup.c
@@ -9,6 +9,7 @@
 
 #include <wlr/types/wlr_scene.h>
 #include <wlr/types/wlr_xdg_shell.h>
+#include "air-spatial.h"
 #include "common/macros.h"
 #include "common/mem.h"
 #include "labwc.h"
@@ -30,6 +31,20 @@ static void
 popup_unconstrain(struct xdg_popup *popup)
 {
 	struct view *view = popup->parent_view;
+	if (air_spatial_active()) {
+		/* Physical primary outputs may be asleep. Their usable area must not
+		 * collapse or displace a popup belonging to a spatially visible client. */
+		struct wlr_xdg_surface *surface = xdg_surface_from_view(view);
+		struct wlr_box bounds = {
+			.x = surface ? surface->current.geometry.x : 0,
+			.y = surface ? surface->current.geometry.y : 0,
+			.width = view->current.width,
+			.height = view->current.height,
+		};
+		wlr_xdg_popup_unconstrain_from_box(popup->wlr_popup, &bounds);
+		return;
+	}
+
 
 	/* Get position of parent toplevel/popup */
 	int parent_lx, parent_ly;
